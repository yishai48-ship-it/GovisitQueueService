{
  "openapi": "3.0.1",
  "info": {
    "title": "Govisit Queue Management Service",
    "description": "Service for managing appointment queues (view / update / delete).",
    "version": "v1"
  },
  "paths": {
    "/api/Appointments/create": {
      "post": {
        "tags": [
          "Appointments"
        ],
        "summary": "Books a new appointment.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAppointmentDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAppointmentDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAppointmentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Appointments/all": {
      "post": {
        "tags": [
          "Appointments"
        ],
        "summary": "Lists all appointments, earliest first.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppointmentDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Appointments/{id}/details": {
      "post": {
        "tags": [
          "Appointments"
        ],
        "summary": "Returns a single appointment by identifier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "maxLength": 24,
              "minLength": 24,
              "pattern": "\\A[0-9a-fA-F]{24}\\z",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Appointments/{id}/update": {
      "post": {
        "tags": [
          "Appointments"
        ],
        "summary": "Updates an existing appointment.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "maxLength": 24,
              "minLength": 24,
              "pattern": "\\A[0-9a-fA-F]{24}\\z",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAppointmentDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAppointmentDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAppointmentDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Appointments/{id}/delete": {
      "post": {
        "tags": [
          "Appointments"
        ],
        "summary": "Cancels an appointment.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "maxLength": 24,
              "minLength": 24,
              "pattern": "\\A[0-9a-fA-F]{24}\\z",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe. Returns 200 while the process is accepting requests.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppointmentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "customerName": {
            "type": "string",
            "nullable": true
          },
          "customerPhone": {
            "type": "string",
            "nullable": true
          },
          "serviceType": {
            "type": "string",
            "nullable": true
          },
          "appointmentDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreateAppointmentDto": {
        "required": [
          "appointmentDate",
          "customerName",
          "customerPhone",
          "serviceType"
        ],
        "type": "object",
        "properties": {
          "customerName": {
            "minLength": 1,
            "pattern": "\\A[A-Za-z\\u0590-\\u05FF]+([ '\\-][A-Za-z\\u0590-\\u05FF]+){0,4}\\z",
            "type": "string"
          },
          "customerPhone": {
            "minLength": 1,
            "pattern": "\\A0(?:5\\d|[2-489])-?\\d{7}\\z",
            "type": "string"
          },
          "serviceType": {
            "minLength": 1,
            "pattern": "\\A[A-Za-z\\u0590-\\u05FF0-9]+([ '\\-][A-Za-z\\u0590-\\u05FF0-9]+){0,9}\\z",
            "type": "string"
          },
          "appointmentDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "UpdateAppointmentDto": {
        "required": [
          "appointmentDate",
          "customerName",
          "customerPhone",
          "serviceType",
          "status"
        ],
        "type": "object",
        "properties": {
          "customerName": {
            "minLength": 1,
            "pattern": "\\A[A-Za-z\\u0590-\\u05FF]+([ '\\-][A-Za-z\\u0590-\\u05FF]+){0,4}\\z",
            "type": "string"
          },
          "customerPhone": {
            "minLength": 1,
            "pattern": "\\A0(?:5\\d|[2-489])-?\\d{7}\\z",
            "type": "string"
          },
          "serviceType": {
            "minLength": 1,
            "pattern": "\\A[A-Za-z\\u0590-\\u05FF0-9]+([ '\\-][A-Za-z\\u0590-\\u05FF0-9]+){0,9}\\z",
            "type": "string"
          },
          "appointmentDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "minLength": 1,
            "pattern": "\\A(Scheduled|Completed|Cancelled)\\z",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}